# Copy to .env and fill in. .env is git-ignored.

# NASA FIRMS Area API key. Free and instant from
# https://firms.modaps.eosdis.nasa.gov/api/map_key
# Required for the polar detection layers. Without it the april-9-demo scene
# falls back to committed fixtures; the current scene reports FIRMS unavailable
# rather than substituting historical records into a feed labelled live.
FIRMS_MAP_KEY=

# Absolute path to a checkout of the BRIGHT pipeline. Optional: without it the
# bright provider reports unavailable and the interface runs on DEA and FIRMS.
# Only the research profile needs this.
BRIGHT_PIPELINE_PATH=

# OpenWeatherMap tile key. Optional; the weather layers hide when absent.
OPENWEATHER_API_KEY=
