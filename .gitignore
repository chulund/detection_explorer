# Staged Himawari AHI parquet. Large and re-downloadable; the tracked manifest in
# manifests/ carries the checksums that make a staging run verifiable.
data/

# Secrets: FIRMS_MAP_KEY, OPENWEATHER_API_KEY, BRIGHT_PIPELINE_PATH.
.env

# Run state: SQLite, journals and cached detection frames.
# Anchored with a leading slash. A bare "runs/" matches at any depth and silently
# swallowed backend/app/runs/, the run-lifecycle source package, for several commits.
/backend/runs/
/runs/
/cache/

node_modules/
dist/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.vite/
.DS_Store
frontend/dist/
